{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * typecheck *)",
      "Bash(pnpm --filter * exec tsc --noEmit *)",
      "Bash(pnpm test *)",
      "Bash(pnpm --filter * exec prisma migrate status *)",
      "Bash(npm info *)",
      "Write(docs/sessions/kickoffs/**)",
      "Write(docs/sessions/logs/**)",
      "Edit(docs/sessions/queue.md)",
      "Edit(docs/modules/*/progress.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-context-budget.sh",
            "statusMessage": "Checking doc budgets"
          }
        ]
      }
    ]
  }
}
