{
  "permissions": {
    "allow": [
      "Bash(pnpm --filter @family-os/api test *)",
      "Bash(pnpm --filter @family-os/platform test *)",
      "Bash(pnpm --filter @family-os/plugin-calendar test *)",
      "Bash(pnpm --filter @family-os/plugin-chores test *)",
      "Bash(pnpm --filter @family-os/plugin-family-feed test *)",
      "Bash(pnpm --filter @family-os/plugin-meals test *)",
      "Bash(pnpm --filter @family-os/plugin-rewards test *)",
      "Bash(pnpm --filter @family-os/plugin-shopping test *)",
      "Bash(pnpm --filter @family-os/shell test *)",
      "Bash(pnpm --filter @family-os/test-utils test *)",
      "Bash(pnpm --filter @family-os/ui test *)",
      "Bash(pnpm --filter @family-os/api typecheck *)",
      "Bash(pnpm --filter @family-os/platform typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-calendar typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-chores typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-family-feed typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-meals typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-rewards typecheck *)",
      "Bash(pnpm --filter @family-os/plugin-shopping typecheck *)",
      "Bash(pnpm --filter @family-os/schemas typecheck *)",
      "Bash(pnpm --filter @family-os/shell typecheck *)",
      "Bash(pnpm --filter @family-os/test-utils typecheck *)",
      "Bash(pnpm --filter @family-os/ui typecheck *)",
      "Bash(pnpm --filter @family-os/api exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/platform exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-calendar exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-chores exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-family-feed exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-meals exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-rewards exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/plugin-shopping exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/schemas exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/shell exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/test-utils exec tsc --noEmit *)",
      "Bash(pnpm --filter @family-os/ui exec tsc --noEmit *)",
      "Bash(pnpm test *)",
      "Bash(pnpm --filter @family-os/api exec prisma migrate status *)",
      "Bash(npm info *)",
      "Edit(docs/sessions/kickoffs/**)",
      "Edit(docs/sessions/logs/**)",
      "Edit(docs/sessions/queue.md)",
      "Edit(docs/modules/*/progress.md)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-context-budget.sh",
            "statusMessage": "Checking doc budgets"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/check-spacing.sh",
            "statusMessage": "Checking the spacing contract"
          }
        ]
      }
    ]
  }
}
