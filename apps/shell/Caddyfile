{$APP_HOST} {
	encode zstd gzip
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	@backend path /api/* /events*
	handle @backend {
		# Caddy's default X-Forwarded-Proto and -For are load-bearing here, not
		# hygiene: the API runs trustProxy:1, so without the former @fastify/session
		# sees a plain-HTTP hop and drops the Secure cookie while still answering
		# 200 (profile switching breaks house-wide, no error anywhere), and the PIN
		# lockout keys on the latter's rightmost entry. Do not disable them; setting
		# them explicitly is redundant and Caddy warns about it.
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# The SPA fallback must not answer for assets: a missing icon would come
		# back as index.html under a 200, which a client cannot decode and cannot
		# distinguish from success.
		@asset path *.png *.jpg *.jpeg *.webp *.svg *.ico *.webmanifest *.js *.css *.map *.json *.woff *.woff2 *.txt
		handle @asset {
			# Mutable files at stable URLs must revalidate on every request
			# (ETag 304s keep that cheap). Without an explicit Cache-Control,
			# browsers apply HEURISTIC freshness — a stale remoteEntry.js
			# outlived two deploys and kept pointing at hashed chunks those
			# deploys had deleted, crashing plugin views through any number of
			# reloads (auto-bug #107).
			@mutable path /sw.js /manifest.webmanifest */remoteEntry.js
			header @mutable Cache-Control "no-cache"

			# Content-hashed bundles never change under their URL.
			@hashed {
				path /assets/* /plugins/*/assets/*
				not path */remoteEntry.js
			}
			header @hashed Cache-Control "public, max-age=31536000, immutable"

			file_server
		}

		handle {
			# The SPA document is as mutable as it gets — same rule as above.
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}
