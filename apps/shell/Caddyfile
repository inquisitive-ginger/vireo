{$APP_HOST} {
	encode zstd gzip
	tls {
		dns cloudflare {$CF_API_TOKEN}
	}

	@backend path /api/* /events*
	handle @backend {
		# Caddy's default X-Forwarded-Proto and -For are load-bearing here, not
		# hygiene: the API runs trustProxy:1, so without the former @fastify/session
		# sees a plain-HTTP hop and drops the Secure cookie while still answering
		# 200 (profile switching breaks house-wide, no error anywhere), and the PIN
		# lockout keys on the latter's rightmost entry. Do not disable them; setting
		# them explicitly is redundant and Caddy warns about it.
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# The SPA fallback must not answer for assets: a missing icon would come
		# back as index.html under a 200, which a client cannot decode and cannot
		# distinguish from success.
		@asset path *.png *.jpg *.jpeg *.webp *.svg *.ico *.webmanifest *.js *.css *.map *.json *.woff *.woff2 *.txt
		handle @asset {
			file_server
		}

		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
