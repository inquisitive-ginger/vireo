generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["calendar"]
}

// A calendar event. A recurring event is the single canonical row; its weekly
// occurrences are computed on read within a queried range (ADR 038) — there is no
// occurrences table. Ownership lives entirely in `event_attendees` (no owner_id):
// 0 rows = Family · 1 = solo · 2+ = shared.
model Event {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  createdBy       String    @map("created_by") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  allDay          Boolean   @default(false) @map("all_day")
  location        String?
  recurrence      String? // 'weekly' | null — MVP weekly only
  recurrenceUntil DateTime? @map("recurrence_until") @db.Date
  isActivity      Boolean   @default(false) @map("is_activity")
  status          String    @default("confirmed") // 'confirmed' | 'suggested' (reserved)
  source          String    @default("manual") // 'manual' now; ingest sources later
  reminderMinutes Int?      @map("reminder_minutes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attendees  EventAttendee[]
  exceptions EventException[]

  @@map("events")
  @@schema("calendar")
}

// Attendee join — the source of truth for ownership/fill. `profile_id` references
// platform.profiles.id, validated in the route (cross-schema FK avoided, per the
// chores precedent).
model EventAttendee {
  eventId   String @map("event_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@map("event_attendees")
  @@schema("calendar")
}

// Per-occurrence exception overlay (ADR 038). A `cancelled` row suppresses exactly
// one weekly occurrence at read-expansion time (gymnastics is off this week).
model EventException {
  eventId        String   @map("event_id") @db.Uuid
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  kind           String   @default("cancelled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, occurrenceDate])
  @@map("event_exceptions")
  @@schema("calendar")
}
