generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["calendar"]
}

// A calendar event. A recurring event is the single canonical row; its weekly
// occurrences are computed on read within a queried range (ADR 038) — there is no
// occurrences table. Ownership lives entirely in `event_attendees` (no owner_id):
// 0 rows = Family · 1 = solo · 2+ = shared.
model Event {
  id              String    @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  createdBy       String    @map("created_by") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  allDay          Boolean   @default(false) @map("all_day")
  location        String?
  recurrence      String? // 'weekly' | 'daily' | null (ADR 038, ADR 057)
  // Weekday set for a 'daily' series, as day OFFSETS from starts_at's weekday
  // mod 7 (ADR 057) — candidate day k occurs iff k % 7 is a member. Offsets, not
  // absolute weekdays: the server has no timezone to resolve a weekday in.
  recurrenceDayOffsets Int[] @default([]) @map("recurrence_day_offsets")
  recurrenceUntil DateTime? @map("recurrence_until") @db.Date
  isActivity      Boolean   @default(false) @map("is_activity")
  status          String    @default("confirmed") // 'confirmed' | 'suggested' (reserved)
  source          String    @default("manual") // 'manual' now; ingest sources later
  reminderMinutes Int?      @map("reminder_minutes")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attendees  EventAttendee[]
  exceptions EventException[]
  reminders  ReminderLog[]

  @@map("events")
  @@schema("calendar")
}

// Attendee join — the source of truth for ownership/fill. `profile_id` references
// platform.profiles.id, validated in the route (cross-schema FK avoided, per the
// chores precedent).
model EventAttendee {
  eventId   String @map("event_id") @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, profileId])
  @@map("event_attendees")
  @@schema("calendar")
}

// Per-occurrence exception overlay (ADR 038). A `cancelled` row suppresses exactly
// one weekly occurrence at read-expansion time (gymnastics is off this week).
model EventException {
  eventId        String   @map("event_id") @db.Uuid
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  kind           String   @default("cancelled")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, occurrenceDate])
  @@map("event_exceptions")
  @@schema("calendar")
}

// Sparse "already fired" ledger for event reminders (ADR 045) — the dual of
// EventException. One row per (event, occurrence) whose reminder has fired, so the
// scheduler poll fires each reminder exactly once and survives restarts. Keeps
// compute-on-read intact (ADR 038): the future is never materialized; this records
// only the past. Cascades on event delete.
model ReminderLog {
  eventId        String   @map("event_id") @db.Uuid
  occurrenceDate DateTime @map("occurrence_date") @db.Date
  firedAt        DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, occurrenceDate])
  @@map("reminder_log")
  @@schema("calendar")
}
