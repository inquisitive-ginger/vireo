generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["shopping"]
}

// source_id is text, not a FK — a producer's push (source_type 'meal') stores
// the planned_meal id, which lives in ANOTHER plugin's schema. `shopping` never
// reads `planned_meals` (ADR 069 §3); the id is an opaque handle back to
// whoever pushed.
// added_by / got_by are text, NOT uuid (ADR 072): `platform.profiles.id` is text
// and holds the literal 'family' for the unattended wall. A uuid column here
// narrows below the id space it references, which is what forced the hand-written
// 403 in front of the one surface whose entire job is capture.
// category is the aisle, assigned by the dictionary on add or by a family-wide
// override going forward (lib/filing.ts) — never chosen per row on the client.
model Item {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  category    String
  quantity    String?
  status      String    @default("needed")
  sourceType  String    @map("source_type")
  sourceId    String?   @map("source_id")
  // The producer's own words for the note line ("for Thursday"). Stored rather
  // than derived: `shopping` cannot read `planned_meals` (ADR 069 §3), so there
  // is nothing to look it up FROM — the push is the only moment the words exist.
  sourceLabel String?   @map("source_label")
  addedBy     String    @map("added_by")
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz(6)
  gotBy       String?   @map("got_by")
  gotAt       DateTime? @map("got_at") @db.Timestamptz(6)
  listId      String    @map("list_id") @db.Uuid
  list        List      @relation(fields: [listId], references: [id])

  @@map("items")
  @@schema("shopping")
}

// A list is its own row, never a column on the item (ADR 067/069). `kind`
// distinguishes the seeded permanent lists (always visible, dim at zero) from a
// tier-4-created runtime one, which appears only while it holds items and
// disappears by emptying, never by a delete action. `groupByAisle` is a
// property of the LIST, not of the app: a hardware run has no aisles of ours.
model List {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  kind         String // 'permanent' | 'runtime'
  groupByAisle Boolean  @default(true) @map("group_by_aisle")
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String?  @map("created_by") // null for the seeded permanent lists
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items Item[]

  @@map("lists")
  @@schema("shopping")
}

// What this family has added before (ADR 069 §1). Its own table rather than a
// DISTINCT over items, because it has to survive a list being emptied. Keyed by
// the same normalizeItemName() shape as the aisle overrides, so "Snap Peas" and
// "snap peas," are one entry. No surface reads it yet — the settled design has
// no completion UI — but every add teaches it, so it is true when one arrives.
model Entry {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedName String   @unique @map("normalized_name")
  name           String
  lastAddedAt    DateTime @default(now()) @map("last_added_at") @db.Timestamptz(6)

  @@map("entries")
  @@schema("shopping")
}

// What a correction teaches: a family-wide refiling of every future add of that
// name. Keyed by the same normalizeItemName() shape the dictionary uses, so a
// correction on "Snap Peas" also refiles "snap peas," on the next add.
model AisleOverride {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedName String   @unique @map("normalized_name")
  category       String
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("aisle_overrides")
  @@schema("shopping")
}
