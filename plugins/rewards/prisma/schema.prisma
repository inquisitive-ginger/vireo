generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["rewards"]
}

model LedgerEntry {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  delta      Int
  reason     String
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // The idempotency claim (ADR 047): a replayed event cannot credit twice. Postgres
  // treats NULLs as distinct under a unique index, so this IS the spec's partial
  // index — entries with no provenance (a manual correction) coexist freely.
  @@unique([sourceType, sourceId])
  @@index([profileId, createdAt])
  @@map("ledger_entries")
  @@schema("rewards")
}

// A cache, not the source of truth — recomputable from the entries at any time
// (ADR 047). It exists so a widget doesn't sum a growing table on every render.
model Balance {
  profileId String   @id @map("profile_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("balances")
  @@schema("rewards")
}

// A payout awaiting a parent's OK (M4/3b). NOT a ledger entry — ADR 047 makes
// entries immutable and the balance their sum, so a "pending" entry would either
// move the balance or break that identity. This row holds the SAME provenance pair
// (sourceType, sourceId) the auto-credit path would have used; approving releases it
// by writing the normal ledger entry with that pair, so release and idempotency are
// one mechanism. Deliberately plugin-agnostic (ADR 048): no `taskId` column — the
// earner encodes what it needs inside sourceId, and rewards knows nothing of chores.
//
// status: pending → approved (ledger entry written) | declined (nothing) | voided
// (the completion was reopened before a decision — nothing was ever owed).
model PendingPayout {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  amount      Int // > 0, the P-Bucks to credit on release
  reason      String
  sourceType  String    @map("source_type")
  sourceId    String    @map("source_id")
  status      String    @default("pending")
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedNote String?   @map("decided_note")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // One held payout per completion instance — a redelivered completed event is a
  // no-op, mirroring the ledger's idempotency claim.
  @@unique([sourceType, sourceId])
  @@index([status, createdAt])
  @@map("pending_payouts")
  @@schema("rewards")
}

// A catalog reward (M4/4). Tier-4 CRUD; a kid redeems it from the store (M4/5).
// `requiresApproval` mirrors the chore payout flag — one concept in two places —
// so a high-value redemption waits for a parent's OK the same way a high-value
// chore payout does. `audience` scopes a reward to specific profiles (null =
// everyone); `stock` caps redemptions (null = unlimited). Retiring a reward flips
// `active` rather than deleting it, so an old redemption keeps its snapshot.
model Reward {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  emoji            String
  description      String?
  cost             Int
  requiresApproval Boolean  @default(false) @map("requires_approval")
  audience         String[] @db.Uuid
  stock            Int?
  active           Boolean  @default(true)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  redemptions Redemption[]

  @@index([active])
  @@map("rewards")
  @@schema("rewards")
}

// A ticket (ADR 055): buying and using are two moments. Buy DEBITS the wallet once,
// with no parent gate at any price (it's the kid's money, ADR 053); `cost` is a
// SNAPSHOT so repricing the reward never moves a ticket already owned.
// `requiresApproval` gates USE, not purchase: a use request waits for a parent, and
// "not now" returns the ticket to owned — the money stays spent, `decided_note` is
// the optional reason quoted back verbatim. Used IS fulfilment; there is no
// hand-off step. The tier-4 revoke exception refunds and DELETES the row, so every
// surviving row holds a stock unit.
//
// status: owned → use_requested → used | use_requested → owned (not now). The
// debit's ledger entry is keyed `(redemption, id)`; the revoke refund `(refund, id)`.
// A punch-card template (ADR 049, reworked 2026-07-31): the parent-authored shape a
// per-profile card is stamped from. The payout is `{coins}` or a curated CHOICE of
// catalog rewards — the parent picks the options, the kid names the one they're
// working for. `payoutOptionIds` carries no FK (arrays can't); the reward DELETE
// route counts membership before hard-deleting, which is the guard the FK gave the
// single-column shape. `audience` scopes like Reward (empty = everyone). Retiring
// flips `active`; cards already open keep going.
model PunchCardTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  glyph           String
  goal            Int
  payoutKind      String   @map("payout_kind")
  payoutCoins     Int?     @map("payout_coins")
  payoutOptionIds String[] @map("payout_option_ids") @db.Uuid
  audience        String[] @db.Uuid
  active          Boolean  @default(true)

  cards PunchCard[]

  @@index([active])
  @@map("punch_card_templates")
  @@schema("rewards")
}

// One kid's card in progress. `chosenRewardId` is the changeable pointer — the prize
// they named, nothing minted until the card fills. `completedAt` set at goal ends it;
// `prizeClaimedAt` marks the mint (immediate for coins or a live pick; deferred to
// the prize sheet when the kid never picked). A fresh card opens in its place, and
// completed cards are retained as history (the finished-cards shelf). At most one
// OPEN card per (template, profile) — a partial unique index in the migration
// enforces what this schema cannot declare.
model PunchCard {
  id             String    @id @default(uuid()) @db.Uuid
  templateId     String    @map("template_id") @db.Uuid
  profileId      String    @map("profile_id") @db.Uuid
  count          Int       @default(0)
  chosenRewardId String?   @map("chosen_reward_id") @db.Uuid
  completedAt    DateTime? @map("completed_at")
  prizeClaimedAt DateTime? @map("prize_claimed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  template PunchCardTemplate @relation(fields: [templateId], references: [id])
  punches  Punch[]

  @@index([profileId, createdAt])
  @@index([templateId, profileId])
  @@map("punch_cards")
  @@schema("rewards")
}

// A single stamp. Manual punches (the kid's tap) carry no source id; event-sourced
// ones (meals.trybite, M5/5) claim (source_type, source_id) so a redelivered event
// cannot stamp twice — the ledger's idempotency pattern.
model Punch {
  id         String   @id @default(uuid()) @db.Uuid
  cardId     String   @map("card_id") @db.Uuid
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  card PunchCard @relation(fields: [cardId], references: [id])

  @@unique([sourceType, sourceId])
  @@index([cardId, createdAt])
  @@map("punches")
  @@schema("rewards")
}

model Redemption {
  id             String    @id @default(uuid()) @db.Uuid
  rewardId       String    @map("reward_id") @db.Uuid
  profileId      String    @map("profile_id") @db.Uuid
  cost           Int
  status         String    @default("owned")
  purchasedAt    DateTime  @default(now()) @map("purchased_at")
  useRequestedAt DateTime? @map("use_requested_at")
  usedAt         DateTime? @map("used_at")
  decidedBy      String?   @map("decided_by") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  decidedNote    String?   @map("decided_note")

  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([status, purchasedAt])
  @@index([profileId, purchasedAt])
  @@map("redemptions")
  @@schema("rewards")
}
