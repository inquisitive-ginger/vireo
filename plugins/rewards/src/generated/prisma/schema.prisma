generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["rewards"]
}

model LedgerEntry {
  id         String   @id @default(uuid()) @db.Uuid
  profileId  String   @map("profile_id") @db.Uuid
  delta      Int
  reason     String
  sourceType String   @map("source_type")
  sourceId   String?  @map("source_id")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  // The idempotency claim (ADR 047): a replayed event cannot credit twice. Postgres
  // treats NULLs as distinct under a unique index, so this IS the spec's partial
  // index — entries with no provenance (a manual correction) coexist freely.
  @@unique([sourceType, sourceId])
  @@index([profileId, createdAt])
  @@map("ledger_entries")
  @@schema("rewards")
}

// A cache, not the source of truth — recomputable from the entries at any time
// (ADR 047). It exists so a widget doesn't sum a growing table on every render.
model Balance {
  profileId String   @id @map("profile_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("balances")
  @@schema("rewards")
}

// A payout awaiting a parent's OK (M4/3b). NOT a ledger entry — ADR 047 makes
// entries immutable and the balance their sum, so a "pending" entry would either
// move the balance or break that identity. This row holds the SAME provenance pair
// (sourceType, sourceId) the auto-credit path would have used; approving releases it
// by writing the normal ledger entry with that pair, so release and idempotency are
// one mechanism. Deliberately plugin-agnostic (ADR 048): no `taskId` column — the
// earner encodes what it needs inside sourceId, and rewards knows nothing of chores.
//
// status: pending → approved (ledger entry written) | declined (nothing) | voided
// (the completion was reopened before a decision — nothing was ever owed).
model PendingPayout {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  amount      Int // > 0, the F$ to credit on release
  reason      String
  sourceType  String    @map("source_type")
  sourceId    String    @map("source_id")
  status      String    @default("pending")
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedNote String?   @map("decided_note")
  decidedAt   DateTime? @map("decided_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // One held payout per completion instance — a redelivered completed event is a
  // no-op, mirroring the ledger's idempotency claim.
  @@unique([sourceType, sourceId])
  @@index([status, createdAt])
  @@map("pending_payouts")
  @@schema("rewards")
}

// A catalog reward (M4/4). Tier-4 CRUD; a kid redeems it from the store (M4/5).
// `requiresApproval` mirrors the chore payout flag — one concept in two places —
// so a high-value redemption waits for a parent's OK the same way a high-value
// chore payout does. `audience` scopes a reward to specific profiles (null =
// everyone); `stock` caps redemptions (null = unlimited). Retiring a reward flips
// `active` rather than deleting it, so an old redemption keeps its snapshot.
model Reward {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  emoji            String
  description      String?
  cost             Int
  requiresApproval Boolean  @default(false) @map("requires_approval")
  audience         String[] @db.Uuid
  stock            Int?
  active           Boolean  @default(true)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  redemptions Redemption[]

  @@index([active])
  @@map("rewards")
  @@schema("rewards")
}

// A kid's request to spend F$ on a reward (M4/4). The F$ is DEBITED on request and
// REFUNDED on decline — not escrow, same effect with half the state (spec). `cost`
// is a SNAPSHOT: repricing the reward must never move a request already in flight.
//
// status: pending → granted → fulfilled (approval path) | granted → fulfilled
// (no-approval reward skips pending) | pending → declined (F$ refunded). The debit's
// ledger entry is keyed `(redemption, id)`; the refund is `(redemption.refund, id)`.
model Redemption {
  id          String    @id @default(uuid()) @db.Uuid
  rewardId    String    @map("reward_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  cost        Int
  status      String    @default("pending")
  requestedAt DateTime  @default(now()) @map("requested_at")
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at")
  decidedNote String?   @map("decided_note")

  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([status, requestedAt])
  @@index([profileId, requestedAt])
  @@map("redemptions")
  @@schema("rewards")
}
