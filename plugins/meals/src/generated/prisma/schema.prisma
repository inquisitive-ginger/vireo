generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["meals"]
}

// owner_id/created_by are plain uuids, not FKs — profiles live in the platform
// schema and cross-schema constraints are off the table (calendar precedent).
// ownerId null = UNCLAIMED, a first-class state (spec.md).
model PlannedMeal {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  slot      String   @default("dinner")
  title     String
  sides     String?
  kind      String   @default("cooked")
  ownerId   String?  @map("owner_id") @db.Uuid
  notes     String?
  tryBite   String?  @map("try_bite")
  needs     String?
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([date, slot])
  @@map("planned_meals")
  @@schema("meals")
}

// ADR 045's shape, dual of calendar.reminder_log: a sparse past-only ledger keyed
// by the day being nudged, not the meal row — its lifetime must track the day,
// not any one meal. `meal_id` is a plain uuid (owner_id/created_by precedent
// above), not an FK: a cascade-on-delete here would let re-planning a deleted
// day's dinner re-fire a nudge that already went out, and a PATCH that moves a
// meal to a new date would leave the row pointing at a meal no longer on that
// date. The 30-day prune reclaims stale rows instead.
model DinnerNudgeLog {
  date     DateTime @db.Date
  audience String
  mealId   String   @map("meal_id") @db.Uuid
  firedAt  DateTime @default(now()) @map("fired_at") @db.Timestamptz(6)

  @@id([date, audience])
  @@map("dinner_nudge_log")
  @@schema("meals")
}

// source_id is text, not a FK — a meal push (source_type 'meal') stores the
// planned_meal id, itself a uuid in the SAME schema, but a plain uuid column
// would forbid a future source that isn't one (spec.md leaves it open).
// category is the aisle, assigned by the dictionary on add or a per-family
// override going forward (grocery-filing.ts) — never redesigned per-row.
model GroceryItem {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  category   String
  quantity   String?
  status     String      @default("needed")
  sourceType String      @map("source_type")
  sourceId   String?     @map("source_id")
  addedBy    String      @map("added_by") @db.Uuid
  addedAt    DateTime    @default(now()) @map("added_at") @db.Timestamptz(6)
  gotBy      String?     @map("got_by") @db.Uuid
  gotAt      DateTime?   @map("got_at") @db.Timestamptz(6)
  listId     String      @map("list_id") @db.Uuid
  list       GroceryList @relation(fields: [listId], references: [id])

  @@map("grocery_items")
  @@schema("meals")
}

// A list is its own row, never a column on the item (ADR 067, design gate
// 2026-08-23) — each store is its own list, home is an index of lists. `kind`
// distinguishes the two seeded permanent lists (always visible, dim at zero)
// from a tier-4-created runtime one (appears only while it holds items —
// disappears by emptying, never by a delete action). `groupByAisle` is a
// property of the LIST, not of the app: a non-food list (not built here, but
// not precluded — handoff spec "What this invalidates") has none.
model GroceryList {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  kind         String // 'permanent' | 'runtime'
  groupByAisle Boolean  @default(true) @map("group_by_aisle")
  sortOrder    Int      @default(0) @map("sort_order")
  createdBy    String?  @map("created_by") @db.Uuid // null for the seeded permanent lists
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  items GroceryItem[]

  @@map("grocery_lists")
  @@schema("meals")
}

// What this family has added before — the ghost completion's dictionary (design
// gate amendment 2026-08-23, which cut the fixed staple list and the chip strip
// with it). Its own table rather than a DISTINCT over grocery_items: completion
// has to survive a list being emptied, and it ships seeded so the field guesses
// on day one. Keyed by the same normalizeItemName() shape as the aisle
// overrides, so "Snap Peas" and "snap peas," are one entry.
model GroceryEntry {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedName String   @unique @map("normalized_name")
  name           String
  lastAddedAt    DateTime @default(now()) @map("last_added_at") @db.Timestamptz(6)

  @@map("grocery_entries")
  @@schema("meals")
}

// The "one small table" design.md calls for corrections to teach (§M5/6) — not
// in spec.md's schema block, which predates the M5/1 design session that
// settled per-family filing corrections. Keyed by the same normalizeItemName()
// shape the dictionary and needs-push dedupe use, so a correction on "Snap
// Peas" also refiles "snap peas," on the next add.
model GroceryAisleOverride {
  id             String   @id @default(uuid()) @db.Uuid
  normalizedName String   @unique @map("normalized_name")
  category       String
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("grocery_aisle_overrides")
  @@schema("meals")
}
