# PostgreSQL — dev database (docker-compose default)
DATABASE_URL=postgresql://familyos:familyos@localhost:5432/familyos

# Session signing key — generate with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-in-production

# Test database — separate from dev to prevent test runs from corrupting dev data.
# Automatically used by `pnpm test` via apps/api/src/test.setup.ts.
TEST_DATABASE_URL=postgresql://familyos:familyos@localhost:5432/familyos_test
