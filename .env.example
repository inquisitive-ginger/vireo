# PostgreSQL — dev database (docker-compose default)
DATABASE_URL=postgresql://familyos:familyos@localhost:5432/familyos

# Session signing key — generate with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-in-production

# .env.test (gitignored) — loaded by the e2e scripts via --env-file.
# DATABASE_URL overrides the dev DB so E2E always hits familyos_test.
# E2E=true disables reuseExistingServer so a fresh API is always started.
# DATABASE_URL=postgresql://familyos:familyos@localhost:5432/familyos_test
# E2E=true
